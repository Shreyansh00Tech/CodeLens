# ---------------------------------------------------------------
# CodeLens frontend build configuration (read at build time by Vite).
# Copy to `.env` (never commit secrets; these values are public by design).
# ---------------------------------------------------------------

# Backend URL. Leave empty when the backend serves the frontend (same origin).
# In `npm run dev` the default is http://localhost:8080.
VITE_API_URL=

# Optional: Supabase project for login / dashboard. The analyzer works without it.
# Use the *public* anon / publishable key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
