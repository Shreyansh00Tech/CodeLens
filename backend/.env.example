# Port for the Express API
PORT=8080

# Optional: enables written, cited AI answers in "Ask AI".
# Without it, Q&A still works in offline mode (returns the most relevant code locations).
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-5-5)
# CODELENS_MODEL=claude-opus-5-5

# Optional: where repositories are cloned (default: ./tmp)
# CODELENS_TMP_DIR=./tmp

# Max /analyze requests per IP per 15 minutes (default 30)
# ANALYZE_RATE_LIMIT_MAX=30
