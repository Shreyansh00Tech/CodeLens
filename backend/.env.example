# ---------------------------------------------------------------
# CodeLens backend configuration. Copy to `.env` (never commit it).
# Every variable is optional; defaults are shown.
# ---------------------------------------------------------------

# HTTP port
PORT=8080

# Ask AI: enables written, cited answers from Claude.
# Without it, Ask AI still answers from static analysis (structure, flows, impact, call sites).
ANTHROPIC_API_KEY=
# Claude model used by Ask AI
# CODELENS_MODEL=claude-opus-5-5

# Where the analyzed repository is cloned (must be writable). Default: ./tmp
# CODELENS_TMP_DIR=./tmp

# Comma-separated list of allowed browser origins. Unset = any origin (fine for local dev).
# Set this in production when the frontend is on another domain.
# CORS_ORIGINS=https://codelens.example.com

# Set when running behind a reverse proxy / load balancer so rate limiting sees client IPs.
# Number of trusted hops (usually 1), or "true".
# TRUST_PROXY=1

# Serve the built frontend from this process: "true" uses ../frontend/dist, or give a path.
# SERVE_FRONTEND=true

# Limits for very large repositories
# CODELENS_MAX_FILES=8000
# CODELENS_MAX_CHUNKS=40000
